def pil_to_jpeg_bytes(image: Image.Image, quality=95):
    buffer = io.BytesIO()
    image.convert("RGB").save(
        buffer,
        format="JPEG",
        quality=quality,
        optimize=True,
    )
    return buffer.getvalue()

def upload_image(bucket_name, path, image):
    data = pil_to_jpeg_bytes(image)

    response = (
        supabase.storage
        .from_(bucket_name)
        .upload(
            path=path,
            file=data,
            file_options={
                "content-type": "image/jpeg",
                "cache-control": "3600",
                "upsert": "false",
            },
        )
    )

    return response

def save_scan_to_supabase(
    patient_name,
    age,
    sex,
    remarks,
    state,
    patient_id,
    emergency_level,
    deterioration_choice,
    spo2,
    resp_rate,
    heart_rate,
):
    # Basic validation
    patient_name = (patient_name or "").strip()
    remarks = (remarks or "").strip()
    sex = (sex or "").strip()
    patient_id = (patient_id or "").strip()

    if not state:
        return error_html(
            "SAVE FAILED",
            "There is no completed scan to save. Analyze a chest X-ray first.",
        ), gr.update(visible=True), gr.update(visible=True)

    if not patient_name:
        return error_html(
            "PATIENT NAME REQUIRED",
            "Please enter the patient's name.",
        ), gr.update(visible=True), gr.update(visible=True)

    if age is None or str(age).strip() == "":
        return error_html(
            "AGE REQUIRED",
            "Please enter the patient's age.",
        ), gr.update(visible=True), gr.update(visible=True)

    try:
        age_int = int(age)
    except Exception:
        return error_html(
            "INVALID AGE",
            "Age must be a whole number.",
        ), gr.update(visible=True), gr.update(visible=True)

    if age_int < 0 or age_int > 120:
        return error_html(
            "INVALID AGE",
            "Please enter an age between 0 and 120.",
        ), gr.update(visible=True), gr.update(visible=True)

    if sex not in {"Male", "Female", "Other", "Prefer not to say"}:
        return error_html(
            "SEX REQUIRED",
            "Please select the patient's sex.",
        ), gr.update(visible=True), gr.update(visible=True)

    if emergency_level not in LEVEL_RANK:
        emergency_level = "LOW"

    original_image = state.get("original_image")
    result_image = state.get("result_image")

    if original_image is None or result_image is None:
        return error_html(
            "IMAGE DATA MISSING",
            "The scan images are no longer available in this session. "
            "Please analyze the X-ray again.",
        ), gr.update(visible=True), gr.update(visible=True)

    # ── Triage calculation ──────────────────────────────────
    spo2_val = _opt_float(spo2)
    rr_val = _opt_float(resp_rate)
    hr_val = _opt_float(heart_rate)

    if deterioration_choice in (None, "", "Auto-detect"):
        previous_vitals = fetch_previous_vitals(patient_id) if patient_id else None
        final_trend = determine_deterioration(
            {"spo2": spo2_val, "rr": rr_val, "hr": hr_val}, previous_vitals
        )
    elif deterioration_choice in TREND_CHOICES:
        final_trend = deterioration_choice
    else:
        final_trend = "UNKNOWN"

    severity_score = compute_severity_score(spo2_val, rr_val, hr_val)
    trend_rank = TREND_RANK.get(final_trend, 1)
    priority_score = (
        LEVEL_RANK.get(emergency_level, 1) * 1000
        + (severity_score or 0.0) * 10
        + trend_rank
    )

    now_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()

    scan_id = str(uuid.uuid4())

    original_path = f"{scan_id}/original.jpg"
    gradcam_path = f"{scan_id}/gradcam.jpg"

    try:
        # 1. Upload original X-ray
        upload_image(
            ORIGINAL_BUCKET,
            original_path,
            original_image,
        )

        # 2. Upload Grad-CAM/result image
        upload_image(
            GRADCAM_BUCKET,
            gradcam_path,
            result_image,
        )

        probs = state.get("probs", {})

        normal_probability = float(probs.get("NORMAL", 0.0)) * 100
        pneumonia_probability = float(probs.get("PNEUMONIA", 0.0)) * 100

        # 3. Insert patient + inference record
        record = {
            "id": scan_id,
            "patient_name": patient_name,
            "age": age_int,
            "sex": sex,
            "remarks": remarks if remarks else None,
            "prediction": state.get("label", "UNKNOWN"),
            "confidence": float(state.get("confidence", 0.0)),
            "region": state.get("region", "N/A"),
            "normal_probability": normal_probability,
            "pneumonia_probability": pneumonia_probability,
            # These columns contain the PRIVATE Supabase Storage object paths.
            "original_image_url": original_path,
            "gradcam_image_url": gradcam_path,
            # ── Triage fields ──
            "patient_id": patient_id if patient_id else None,
            "emergency_level": emergency_level,
            "spo2": spo2_val,
            "respiratory_rate": rr_val,
            "heart_rate": hr_val,
            "deterioration_status": final_trend,
            "priority_score": round(priority_score, 2),
            "triage_status": "WAITING",
            "waiting_since": now_iso,
        }

        result = (
            supabase
            .table("patient_scans")
            .insert(record)
            .execute()
        )

        print(f"[ChestScan] Saved patient scan: {scan_id}")
        print(f"[ChestScan] Database response: {result}")

        vitals_line = " · ".join(
            filter(
                None,
                [
                    f"SpO₂ {spo2_val}%" if spo2_val is not None else None,
                    f"RR {rr_val}/min" if rr_val is not None else None,
                    f"HR {hr_val} bpm" if hr_val is not None else None,
                ],
            )
        ) or "no vitals recorded"

        return (
            success_html(
                "SCAN SAVED",
                (
                    f"Patient: {patient_name}<br>"
                    f"Prediction: {state.get('label', 'UNKNOWN')}<br>"
                    f"Confidence: {float(state.get('confidence', 0.0)):.1f}%<br>"
                    f"{LEVEL_EMOJI.get(emergency_level,'⚪')} Emergency level: "
                    f"<b style='color:{LEVEL_COLOR.get(emergency_level,'#c7cede')}'>{emergency_level}</b><br>"
                    f"{TREND_EMOJI.get(final_trend,'❔')} Trend: {final_trend}<br>"
                    f"Vitals: {vitals_line}<br>"
                    f"Record ID: {scan_id}"
                    f"<div style='margin-top:10px;font-size:11px;color:#6b5040'>{TRIAGE_DISCLAIMER}</div>"
                ),
            ),
            gr.update(visible=False),
            gr.update(visible=False),
        )

    except Exception as e:
        print("[ChestScan] Supabase save failed:")
        print(traceback.format_exc())

        # Best-effort cleanup if DB insert/upload sequence failed.
        try:
            supabase.storage.from_(ORIGINAL_BUCKET).remove([original_path])
        except Exception:
            pass

        try:
            supabase.storage.from_(GRADCAM_BUCKET).remove([gradcam_path])
        except Exception:
            pass

        return (
            error_html(
                "SUPABASE SAVE FAILED",
                (
                    "The patient record could not be saved.<br>"
                    "If this is the first triage-enabled save, make sure you've "
                    "run the ALTER TABLE migration for the new triage columns."
                    "<br><br>"
                    f"<small>{str(e)}</small>"
                ),
            ),
            gr.update(visible=True),
            gr.update(visible=True),
        )

