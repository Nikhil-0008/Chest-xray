def make_analysis_state(
    label,
    confidence,
    region,
    prob_str,
    original_image=None,
    result_image=None,
):
    return {
        "label": label,
        "confidence": float(confidence),
        "region": region,
        "probs": prob_str,
        "original_image": original_image.copy() if original_image is not None else None,
        "result_image": result_image.copy() if result_image is not None else None,
    }

