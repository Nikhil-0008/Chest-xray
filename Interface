# MAIN INFERENCE
# ─────────────────────────────────────────────────────────────
def analyze(pil_img: Image.Image):
    if pil_img is None:
        return (
            None,
            info_html("Awaiting scan input. Upload a chest X-ray and run ANALYZE."),
            0.0,
            "—",
            None,
            gr.update(visible=False),  # save_question
            gr.update(visible=False),  # patient_form
        )

    try:
        is_valid, reason = validate_chest_xray(pil_img)

        if not is_valid:
            return (
                pil_img,
                error_html(
                    "INVALID INPUT — NOT A CHEST X-RAY",
                    f"{reason if reason else 'This image does not appear to be a chest radiograph.'}"
                    "<br>Please upload a frontal (PA) chest X-ray and re-run.",
                ),
                0.0,
                "N/A",
                None,
                gr.update(visible=False),
                gr.update(visible=False),
            )

        original = pil_img.convert("RGB").copy()

        tensor = preprocess(original)
        raw = model.predict(tensor, verbose=0)[0]

        if IS_SIGMOID_BINARY:
            p_pneumonia = float(raw[0])
            probs = np.array(
                [1.0 - p_pneumonia, p_pneumonia],
                dtype=np.float32
            )
        else:
            probs = np.asarray(raw, dtype=np.float32)

        pred_idx = int(np.argmax(probs))
        confidence = float(probs[pred_idx]) * 100
        label = CLASS_NAMES[pred_idx]

        prob_str = {
            CLASS_NAMES[i]: f"{float(p):.3f}"
            for i, p in enumerate(probs)
        }

        print(f"\n[Predict] {prob_str}")
        print(
            f"          → index {pred_idx} = '{label}' "
            f"({confidence:.1f}%)"
        )

        if pred_idx == NORMAL_IDX:
            out = original.copy()

            d = ImageDraw.Draw(out)
            txt = "CLEAR"
            fnt = ImageFont.load_default()
            bb = d.textbbox((0, 0), txt, font=fnt)
            tw, th = bb[2] - bb[0], bb[3] - bb[1]
            p = 8

            d.rectangle(
                [10, 10, 10 + tw + p * 2, 10 + th + p * 2],
                fill=(61, 220, 132),
                outline=(20, 140, 80),
                width=2,
            )
            d.text(
                (10 + p, 10 + p),
                txt,
                fill=(10, 12, 16),
                font=fnt,
            )

            state = make_analysis_state(
                "NORMAL",
                confidence,
                "N/A",
                prob_str,
                original,
                out,
            )

            return (
                out,
                clear_html(confidence, prob_str),
                round(confidence, 1),
                "N/A",
                state,
                gr.update(visible=True),
                gr.update(visible=False),
            )

        # PNEUMONIA → Grad-CAM + overlay
        gradcam_target_idx = 0 if IS_SIGMOID_BINARY else pred_idx
        cam = compute_gradcam(tensor, gradcam_target_idx)

        annotated, region = draw_finding_marker(
            original.copy(),
            cam,
            FINDING_COLOR_RGB,
        )

        state = make_analysis_state(
            label,
            confidence,
            region,
            prob_str,
            original,
            annotated,
        )

        return (
            annotated,
            finding_html(label, confidence, region, prob_str),
            round(confidence, 1),
            region,
            state,
            gr.update(visible=True),
            gr.update(visible=False),
        )

    except Exception as e:
        print(traceback.format_exc())

        return (
            pil_img,
            error_html("ANALYSIS FAULT", str(e)),
            0.0,
            "Error",
            None,
            gr.update(visible=False),
            gr.update(visible=False),
        )

