# EMERGENCY TRIAGE PRIORITY SYSTEM
# ─────────────────────────────────────────────────────────────
# This block implements the triage ordering hierarchy:
#   1. Emergency level (CRITICAL > HIGH > MODERATE > LOW)
#   2. Clinical severity indicators (SpO2 / RR / HR — only if provided)
#   3. Deterioration trend (WORSENING > STABLE/UNKNOWN > IMPROVING)
#   4. Waiting time (longer wait = higher priority)
#   5. FIFO on registration timestamp as the final tie-breaker
#
# Patient name and UID are NEVER used as a priority input — only as labels.
# Missing vitals are excluded from the score, never assumed/fabricated.

TRIAGE_DISCLAIMER = (
    "⚠ Triage priority is decision support only. Clinical staff must make "
    "the final prioritization decision."
)

EMERGENCY_LEVELS = ["CRITICAL", "HIGH", "MODERATE", "LOW"]
LEVEL_RANK = {"CRITICAL": 4, "HIGH": 3, "MODERATE": 2, "LOW": 1}
LEVEL_COLOR = {
    "CRITICAL": "#ff3b4e",
    "HIGH": "#ff9d3d",
    "MODERATE": "#ffd23d",
    "LOW": "#3ddc84",
}
LEVEL_EMOJI = {"CRITICAL": "🔴", "HIGH": "🟠", "MODERATE": "🟡", "LOW": "🟢"}

TREND_CHOICES = ["WORSENING", "STABLE", "IMPROVING", "UNKNOWN"]
TREND_RANK = {"WORSENING": 2, "STABLE": 1, "UNKNOWN": 1, "IMPROVING": 0}
TREND_EMOJI = {"WORSENING": "📉", "STABLE": "➖", "IMPROVING": "📈", "UNKNOWN": "❔"}

DETERIORATION_DROPDOWN_CHOICES = ["Auto-detect"] + TREND_CHOICES


def _opt_float(value):
    """Best-effort optional float parse. Returns None for blank/invalid —
    never fabricates a value."""
    if value is None:
        return None
    try:
        s = str(value).strip()
        if s == "":
            return None
        return float(value)
    except Exception:
        return None


def compute_severity_score(spo2, rr, hr):
    """Combines only the vitals that are actually available into a single
    non-negative severity score (higher = more urgent). Returns None only
    if NO vitals were provided at all, so callers can distinguish "no data"
    from "normal vitals" instead of inventing a neutral value.

    IMPORTANT: presence of a vital is tracked independently from whether it
    contributes to the score. A normal SpO2/RR/HR contributes 0 but still
    counts as "data was provided" — it must NOT be treated the same as
    "nothing was entered", otherwise downstream code falls back to
    confidence-only scoring and can suggest HIGH/CRITICAL even when the
    entered vitals are perfectly normal.
    """
    spo2 = _opt_float(spo2)
    rr = _opt_float(rr)
    hr = _opt_float(hr)

    if spo2 is None and rr is None and hr is None:
        return None

    score = 0.0

    if spo2 is not None:
        score += max(0.0, 95.0 - spo2) * 3.0

    if rr is not None:
        if rr > 20:
            score += (rr - 20) * 2.0
        elif rr < 12:
            score += (12 - rr) * 2.0

    if hr is not None:
        if hr > 100:
            score += (hr - 100) * 1.0
        elif hr < 60:
            score += (60 - hr) * 1.0

    return round(score, 2)


def determine_deterioration(current, previous):
    """Compares the current visit's vitals against the most recent prior
    visit for the same patient_id. Only compares fields present on BOTH
    records; if nothing overlaps, returns UNKNOWN rather than guessing."""
    if not previous:
        return "UNKNOWN"

    worse = 0
    better = 0
    compared = 0

    def _cmp(cur, prev, higher_is_worse, threshold):
        nonlocal worse, better, compared
        cur = _opt_float(cur)
        prev = _opt_float(prev)
        if cur is None or prev is None:
            return
        compared += 1
        diff = cur - prev
        if higher_is_worse:
            if diff > threshold:
                worse += 1
            elif diff < -threshold:
                better += 1
        else:
            if diff < -threshold:
                worse += 1
            elif diff > threshold:
                better += 1

    _cmp(current.get("spo2"), previous.get("spo2"), higher_is_worse=False, threshold=1.5)
    _cmp(current.get("rr"), previous.get("rr"), higher_is_worse=True, threshold=2)
    _cmp(current.get("hr"), previous.get("hr"), higher_is_worse=True, threshold=8)

    if compared == 0:
        return "UNKNOWN"
    if worse > 0 and worse >= better:
        return "WORSENING"
    if better > 0 and better > worse:
        return "IMPROVING"
    return "STABLE"


def suggest_emergency_level(label, confidence, severity_score):
    """A starting suggestion only — always shown as editable in the UI so a
    clinician can override it.

    Vitals drive this, not model confidence. A high-confidence PNEUMONIA
    call with normal vitals should land at MODERATE, not HIGH/CRITICAL —
    confidence describes how sure the model is about the finding, not how
    urgent the patient's condition is. Confidence only nudges the level
    when there are NO vitals to go on yet."""
    if label != "PNEUMONIA":
        return "LOW"

    if severity_score is None:
        # No vitals entered yet — fall back to confidence only, and never
        # suggest CRITICAL on imaging confidence alone.
        return "HIGH" if (confidence or 0) >= 95 else "MODERATE"

    if severity_score >= 25:
        return "CRITICAL"
    if severity_score >= 12:
        return "HIGH"
    # severity_score is 0 (vitals entered and all within normal range) or a
    # small positive value — either way this is a confirmed finding that
    # deserves attention but isn't in vital-sign distress.
    return "MODERATE"


def _parse_ts(value):
    if not value:
        return datetime.datetime.now(datetime.timezone.utc)
    try:
        s = str(value).replace("Z", "+00:00")
        ts = datetime.datetime.fromisoformat(s)
        if ts.tzinfo is None:
            ts = ts.replace(tzinfo=datetime.timezone.utc)
        return ts
    except Exception:
        return datetime.datetime.now(datetime.timezone.utc)


def compute_priority_key(rec):
    """Sort key implementing the full triage hierarchy. Sorting a list of
    records ascending by this key puts the highest-priority patient first.
    Name and UID never enter this calculation."""
    level = rec.get("emergency_level") or "LOW"
    level_rank = LEVEL_RANK.get(level, 1)

    severity = compute_severity_score(
        rec.get("spo2"), rec.get("respiratory_rate"), rec.get("heart_rate")
    )
    severity_val = severity if severity is not None else 0.0

    trend = rec.get("deterioration_status") or "UNKNOWN"
    trend_rank = TREND_RANK.get(trend, 1)

    ts = _parse_ts(rec.get("waiting_since") or rec.get("created_at"))
    now = datetime.datetime.now(datetime.timezone.utc)
    waiting_seconds = max(0.0, (now - ts).total_seconds())

    # Descending on level/severity/trend/waiting, then FIFO ascending on the
    # raw timestamp as the absolute final tie-breaker.
    return (-level_rank, -severity_val, -trend_rank, -waiting_seconds, ts.timestamp())


def fetch_previous_vitals(patient_id):
    """Looks up the most recent prior scan for this patient_id (used purely
    for trend detection). Returns None if no patient_id was given or none
    is found — never invents history."""
    if not patient_id or not str(patient_id).strip():
        return None
    try:
        result = (
            supabase.table("patient_scans")
            .select("spo2,respiratory_rate,heart_rate,created_at")
            .eq("patient_id", str(patient_id).strip())
            .order("created_at", desc=True)
            .limit(1)
            .execute()
        )
        rows = result.data or []
        if not rows:
            return None
        r = rows[0]
        return {"spo2": r.get("spo2"), "rr": r.get("respiratory_rate"), "hr": r.get("heart_rate")}
    except Exception as e:
        print(f"[ChestScan] Could not fetch previous vitals: {e}")
        return None


def recalc_suggestion(state, spo2, rr, hr, patient_id):
    label = state.get("label") if state else "NORMAL"
    confidence = state.get("confidence") if state else 0

    severity = compute_severity_score(spo2, rr, hr)
    suggested_level = suggest_emergency_level(label, confidence, severity)

    trend = "UNKNOWN"
    has_current = any(_opt_float(v) is not None for v in (spo2, rr, hr))
    if patient_id and has_current:
        previous = fetch_previous_vitals(patient_id)
        trend = determine_deterioration({"spo2": spo2, "rr": rr, "hr": hr}, previous)

    trend_dropdown_value = trend if trend != "UNKNOWN" else "Auto-detect"
    return gr.update(value=suggested_level), gr.update(value=trend_dropdown_value)


# PREPROCESSING
def preprocess(pil_img: Image.Image) -> np.ndarray:
    rgb = np.array(pil_img.convert("RGB"))
    rgb = cv2.resize(rgb, (INPUT_SIZE, INPUT_SIZE)).astype(np.float32)
    arr = preprocess_input(rgb)
    return np.expand_dims(arr, axis=0)


# CHEST X-RAY VALIDATION
def validate_chest_xray(pil_img: Image.Image):
    if not OPENROUTER_API_KEY:
        msg = (
            "No OPENROUTER_API_KEY is set, so image validation cannot run. "
            "Set the environment variable and restart the app."
        )
        print(f"[ChestScan] GATE BLOCKED: {msg}")
        return False, msg

    buf = io.BytesIO()
    pil_img.convert("RGB").save(buf, format="JPEG", quality=88)
    b64 = base64.b64encode(buf.getvalue()).decode("utf-8")

    payload = {
        "model": OPENROUTER_VISION_MODEL,
        "messages": [
            {
                "role": "system",
                "content": (
                    "You are a strict image-type gatekeeper for a medical imaging "
                    "tool. You only ever respond with compact JSON, nothing else."
                ),
            },
            {
                "role": "user",
                "content": [
                    {
                        "type": "text",
                        "text": (
                            "Is this image an actual clinical chest X-ray (radiograph)? "
                            "It must specifically be a chest X-ray — reject brain MRI/CT "
                            "scans, other body-part X-rays, other medical images, "
                            "illustrations, and ordinary photos. "
                            'Respond ONLY with JSON in exactly this shape: '
                            '{"is_chest_xray": true or false, "reason": "<one short sentence>"}'
                        ),
                    },
                    {
                        "type": "image_url",
                        "image_url": {"url": f"data:image/jpeg;base64,{b64}"},
                    },
                ],
            },
        ],
        "temperature": 0,
        "max_tokens": 120,
    }

    try:
        resp = requests.post(
            OPENROUTER_URL,
            headers={
                "Authorization": f"Bearer {OPENROUTER_API_KEY}",
                "Content-Type": "application/json",
            },
            data=json.dumps(payload),
            timeout=30,
        )
    except Exception as e:
        msg = f"Network error reaching OpenRouter: {e}"
        print(f"[ChestScan] GATE BLOCKED: {msg}")
        return False, msg

    if resp.status_code != 200:
        print(
            f"[ChestScan] GATE BLOCKED: OpenRouter returned HTTP "
            f"{resp.status_code}: {resp.text[:300]}"
        )
        return False, (
            "Could not verify this is a chest X-ray "
            f"(API error {resp.status_code} — check your OPENROUTER_API_KEY)."
        )

    try:
        raw_content = resp.json()["choices"][0]["message"]["content"].strip()
    except Exception as e:
        print(f"[ChestScan] Unexpected API response shape: {e}")
        return False, "Could not verify this is a chest X-ray (unexpected API response)."

    match = re.search(r"\{.*\}", raw_content, re.DOTALL)
    if not match:
        print(f"[ChestScan] GATE BLOCKED: no JSON found: '{raw_content}'")
        return False, "Could not verify this is a chest X-ray (unparseable response)."

    try:
        parsed = json.loads(match.group(0))
    except Exception as e:
        print(f"[ChestScan] GATE BLOCKED: JSON parse error: {e}")
        return False, "Could not verify this is a chest X-ray (unparseable response)."

    is_valid = bool(parsed.get("is_chest_xray", False))
    reason = str(parsed.get("reason", "")).strip()

    print(
        f"[ChestScan] Vision gate → is_chest_xray={is_valid} reason='{reason}'"
    )
    return is_valid, reason


# GRAD-CAM

def compute_gradcam(tensor: np.ndarray, class_idx: int) -> np.ndarray:
    with tf.GradientTape() as tape:
        conv_outputs, predictions = gradcam_model(
            tf.cast(tensor, tf.float32), training=False
        )
        tape.watch(conv_outputs)
        class_channel = predictions[:, class_idx]

    grads = tape.gradient(class_channel, conv_outputs)
    pooled_grads = tf.reduce_mean(grads, axis=(0, 1, 2))
    conv_out = conv_outputs[0]

    heatmap = conv_out @ pooled_grads[..., tf.newaxis]
    heatmap = tf.squeeze(heatmap)
    heatmap = tf.maximum(heatmap, 0)
    heatmap = heatmap / (tf.reduce_max(heatmap) + 1e-10)

    return heatmap.numpy()

def draw_finding_marker(pil_img: Image.Image, cam: np.ndarray, color: tuple):
    orig = np.array(pil_img.convert("RGB"))
    H, W = orig.shape[:2]

    cam_up = cv2.resize(cam, (W, H), interpolation=cv2.INTER_CUBIC)

    heat_bgr = cv2.applyColorMap(
        (cam_up * 255).astype(np.uint8),
        cv2.COLORMAP_JET
    )
    heat_rgb = cv2.cvtColor(heat_bgr, cv2.COLOR_BGR2RGB)
    blended = cv2.addWeighted(orig, 0.55, heat_rgb, 0.45, 0)

    cy, cx = np.unravel_index(np.argmax(cam_up), cam_up.shape)
    cx, cy = int(cx), int(cy)

    active = (cam_up > 0.4).astype(np.uint8)
    area = int(active.sum())
    r_spread = max(22, int(np.sqrt(area / np.pi)))
    r_dot = max(10, r_spread // 4)

    WHITE = (255, 255, 255)

    for i in range(30):
        a0 = int(360 / 30 * i)
        a1 = int(a0 + 7)
        cv2.ellipse(
            blended,
            (cx, cy),
            (r_spread, r_spread),
            0,
            a0,
            a1,
            color,
            2,
            cv2.LINE_AA,
        )

    cv2.circle(blended, (cx, cy), r_dot + 5, WHITE, 2, cv2.LINE_AA)
    cv2.circle(blended, (cx, cy), r_dot, color, -1, cv2.LINE_AA)

    hi = (
        min(255, color[0] + 80),
        min(255, color[1] + 80),
        min(255, color[2] + 80),
    )

    cv2.circle(
        blended,
        (cx - r_dot // 4, cy - r_dot // 4),
        max(2, r_dot // 3),
        hi,
        -1,
        cv2.LINE_AA,
    )

    gap, ext = r_dot + 6, r_spread + 18
    cv2.line(blended, (cx - ext, cy), (cx - gap, cy), color, 1, cv2.LINE_AA)
    cv2.line(blended, (cx + gap, cy), (cx + ext, cy), color, 1, cv2.LINE_AA)
    cv2.line(blended, (cx, cy - ext), (cx, cy - gap), color, 1, cv2.LINE_AA)
    cv2.line(blended, (cx, cy + gap), (cx, cy + ext), color, 1, cv2.LINE_AA)

    tag = "OPACITY"
    font = cv2.FONT_HERSHEY_SIMPLEX
    (tw, th), _ = cv2.getTextSize(tag, font, 0.48, 1)

    tx = cx + r_spread + 8
    ty = cy + th // 2

    if tx + tw + 10 > W:
        tx = cx - r_spread - tw - 12

    cv2.rectangle(
        blended,
        (tx - 3, ty - th - 5),
        (tx + tw + 7, ty + 5),
        color,
        -1,
    )
    cv2.putText(
        blended,
        tag,
        (tx + 2, ty),
        font,
        0.48,
        WHITE,
        1,
        cv2.LINE_AA,
    )

    qx = "Left" if cx < W * 0.5 else "Right"
    qy = "Upper" if cy < H * 0.5 else "Lower"
    region = f"{qx} {qy} lung field (x={cx}, y={cy})"

    return Image.fromarray(blended), region

