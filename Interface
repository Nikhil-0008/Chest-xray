HISTORY_LIMIT = 10
TRIAGE_LIMIT = 50

# What counts as "needs a second look" in a remark — this is a simple
# keyword heuristic, not clinical judgement. Tweak this list to fit how
# your team actually writes remarks.
FLAG_KEYWORDS = [
    "urgent", "follow up", "follow-up", "followup", "refer", "referral",
    "worsening", "worse", "readmit", "critical", "immediate", "asap",
    "recheck", "repeat scan", "review needed",
]

def compute_scan_status(remarks):
    """
    Turns a free-text remark into a traffic-light status:
      - no remarks at all        -> PENDING REVIEW (amber)
      - remarks with a flag word -> FLAGGED (red)
      - any other remarks        -> REVIEWED (green)
    """
    if not remarks or not str(remarks).strip():
        return "PENDING REVIEW", "⏳", "#ffb020"

    text = str(remarks).lower()
    if any(word in text for word in FLAG_KEYWORDS):
        return "FLAGGED", "🚩", ALERT_RED

    return "REVIEWED", "✅", SAFE_GREEN

def _get_signed_url(bucket_name, path, expires_in=600):
    """Best-effort thumbnail URL. Buckets are private, so this needs a
    signed URL; if it fails for any reason (missing file, policy, older
    supabase-py version with a different return shape) we just skip the
    thumbnail instead of breaking the whole history panel."""
    if not path:
        return None
    try:
        res = supabase.storage.from_(bucket_name).create_signed_url(path, expires_in)
        if isinstance(res, dict):
            return res.get("signedURL") or res.get("signedUrl") or res.get("signed_url")
        return getattr(res, "signed_url", None)
    except Exception as e:
        print(f"[ChestScan] Could not sign URL for {bucket_name}/{path}: {e}")
        return None

def fetch_patient_history(limit=HISTORY_LIMIT):
    """Pulls the most recent scans from Supabase. Tries to order by
    created_at (the usual Supabase default timestamp column); if that
    column doesn't exist on your table, falls back to unordered so the
    panel still works rather than crashing."""
    try:
        query = (
            supabase.table("patient_scans")
            .select("*")
            .order("created_at", desc=True)
            .limit(limit)
        )
        result = query.execute()
        return result.data or []
    except Exception as e:
        print(f"[ChestScan] Ordered history fetch failed ({e}); retrying without order.")
        try:
            result = (
                supabase.table("patient_scans")
                .select("*")
                .limit(limit)
                .execute()
            )
            return result.data or []
        except Exception as e2:
            print(f"[ChestScan] History fetch failed entirely: {e2}")
            return None  # signals a hard failure vs. an empty table

def fetch_triage_queue_records(limit=TRIAGE_LIMIT):
    """Pulls patients still marked WAITING for the live triage queue. Falls
    back gracefully if the triage_status column doesn't exist yet (pre-
    migration) so the panel reports a clear error instead of hanging."""
    try:
        result = (
            supabase.table("patient_scans")
            .select("*")
            .eq("triage_status", "WAITING")
            .order("created_at", desc=True)
            .limit(limit)
            .execute()
        )
        return result.data or []
    except Exception as e:
        print(f"[ChestScan] Triage queue fetch failed ({e}); falling back to full table.")
        try:
            result = (
                supabase.table("patient_scans")
                .select("*")
                .limit(limit)
                .execute()
            )
            return result.data or []
        except Exception as e2:
            print(f"[ChestScan] Triage queue fallback fetch failed: {e2}")
            return None

def _triage_checklist_choices(records):
    """Builds (label, value) choices for the "mark completed" checklist,
    in the same priority order as the queue itself so ticking top-to-
    bottom matches what's displayed on screen."""
    if not records:
        return []
    ordered = sorted(records, key=compute_priority_key)
    choices = []
    for rec in ordered:
        level = rec.get("emergency_level") or "LOW"
        emoji = LEVEL_EMOJI.get(level, "⚪")
        name = rec.get("patient_name", "Unknown")
        rid = rec.get("id")
        choices.append((f"{emoji} {name} — {level}", rid))
    return choices


def mark_patients_completed(selected_ids):
    """Marks the ticked patients as no longer waiting (triage_status ->
    DISCHARGED) so they drop out of the live queue. Only the ticked
    records are touched — nothing else about them changes."""
    if not selected_ids:
        return gr.update(), gr.update()

    failed = []
    for rid in selected_ids:
        try:
            (
                supabase.table("patient_scans")
                .update({"triage_status": "DISCHARGED"})
                .eq("id", rid)
                .execute()
            )
        except Exception as e:
            print(f"[ChestScan] Could not mark {rid} completed: {e}")
            failed.append(rid)

    records = fetch_triage_queue_records()
    html = build_triage_queue_html(records)

    if failed:
        html = error_html(
            "SOME UPDATES FAILED",
            f"Could not mark {len(failed)} patient(s) as completed. "
            "Check your connection and try again.",
        ) + html

    choices = _triage_checklist_choices(records) if records is not None else []
    return html, gr.update(choices=choices, value=[])


def _humanize_wait(ts_raw):
    ts = _parse_ts(ts_raw)
    now = datetime.datetime.now(datetime.timezone.utc)
    seconds = max(0, (now - ts).total_seconds())
    minutes = int(seconds // 60)
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    rem = minutes % 60
    return f"{hours}h {rem}m"

