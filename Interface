GREETING = (
    "Upload a scan for an instant read, or ask me anything about "
    "pneumonia and chest imaging."
)

SUGGESTED_PROMPTS = [
    "What does this result mean?",
    "What symptoms should I watch for?",
    "How accurate is X-ray screening?",
]

SYSTEM_PROMPT_TEMPLATE = """You are the "Assistant" embedded inside ChestScan AI,
a chest-radiograph pneumonia-screening console.

Your ONLY job is to help the user understand:
1) The specific prediction ChestScan just produced for their uploaded scan.
2) General, educational information about pneumonia, chest X-rays, and
   Grad-CAM / CNN-based classifiers.

Current analysis context:
{context_block}

Rules:
- If the user asks why a region is marked, explain it in terms of Grad-CAM activation.
- You may explain lung anatomy and general educational chest X-ray information.
- You are NOT a doctor and must not give a personal diagnosis, treatment plan,
  or prognosis for a named patient.
- Always note that a qualified radiologist/clinician must confirm any finding.
- If unrelated to this scan or chest imaging, politely redirect.
- Be concise, clear, and accurate.
"""

def _build_context_block(state):
    if not state or not state.get("label"):
        return "No scan has been analyzed yet in this session."

    if state["label"] == "NORMAL":
        return (
            f"Prediction: NORMAL (no pneumonia finding)\n"
            f"Confidence: {state['confidence']:.1f}%\n"
            f"Full probabilities: {state['probs']}"
        )

    return (
        f"Prediction: {state['label']} (finding detected)\n"
        f"Confidence: {state['confidence']:.1f}%\n"
        f"Marked location on scan: {state['region']}\n"
        f"Full probabilities: {state['probs']}\n"
        f"Note: the marked point is the pixel of maximum Grad-CAM activation "
        f"from the final convolutional block ('{GRADCAM_LAYER}') for the "
        f"predicted class."
    )

def chat_with_assistant(message, history, state):
    if not message or not message.strip():
        return history, ""

    history = history or []

    if not OPENROUTER_API_KEY:
        history = history + [
            {"role": "user", "content": message},
            {
                "role": "assistant",
                "content": (
                    "⚠️ OPENROUTER_API_KEY is not configured. "
                    "Set it and restart the app."
                ),
            },
        ]
        return history, ""

    context_block = _build_context_block(state)
    system_prompt = SYSTEM_PROMPT_TEMPLATE.format(
        context_block=context_block
    )

    api_messages = [
        {"role": "system", "content": system_prompt}
    ]

    for turn in history[-8:]:
        if turn.get("role") in ("user", "assistant"):
            api_messages.append({
                "role": turn["role"],
                "content": turn["content"],
            })

    api_messages.append({
        "role": "user",
        "content": message,
    })

    try:
        resp = requests.post(
            OPENROUTER_URL,
            headers={
                "Authorization": f"Bearer {OPENROUTER_API_KEY}",
                "Content-Type": "application/json",
            },
            data=json.dumps({
                "model": OPENROUTER_MODEL,
                "messages": api_messages,
                "temperature": 0.4,
                "max_tokens": 500,
            }),
            timeout=30,
        )

        resp.raise_for_status()
        data = resp.json()
        reply = data["choices"][0]["message"]["content"].strip()

    except Exception as e:
        reply = f"⚠️ Couldn't reach the explanation service ({e})."

    history = history + [
        {"role": "user", "content": message},
        {"role": "assistant", "content": reply},
    ]

    return history, ""

def use_suggested_prompt(prompt, history, state):
    return chat_with_assistant(prompt, history, state)

